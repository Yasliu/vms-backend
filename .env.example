# Copy to ".env" (git-ignored) and fill in real values. Never commit ".env".
# Format: plain KEY=value, no quotes, no spaces around "=".
# If the password contains a backslash, write it doubled (\\).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vms
DB_USERNAME=vms_app
DB_PASSWORD=change-me

# Authentication. JWT_SECRET is required (>= 32 chars): generate with `openssl rand -base64 48`.
# These are blank on purpose: the app refuses to start without a JWT_SECRET, so a copied template can never
# run with a publicly known key. Fill in your own values.
JWT_SECRET=
# First admin account, created only while no users exist (password: 12-72 chars). Remove after first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Self-service sign-up. People must enter this code on the sign-up screen. Leave unset to turn sign-up off.
# At least 12 characters; generate one with `openssl rand -base64 18`. Treat it like a password.
REGISTRATION_CODE=

# Optional
# JWT_TTL=30m
# DB_POOL_SIZE=10
# DB_CONNECTION_TIMEOUT_MS=10000
# JPA_DDL_AUTO=update
# Origins (browser frontends) allowed to call the API, comma-separated. Default: local dev servers only.
# CORS_ALLOWED_ORIGINS=https://vms.example.com
